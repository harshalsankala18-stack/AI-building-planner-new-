# ==============================================================================
# AI Floor Planner SaaS — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & AI Brief Interpretation
# ------------------------------------------------------------------------------
PORT=4200
NODE_ENV=development

# Gemini API Key (optional for deterministic generation; required for natural language brief interpretation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
BRIEF_INTERPRETER=gemini # 'gemini' | 'local-stub'

# ------------------------------------------------------------------------------
# 2. Database & State Persistence (Phase 5)
# ------------------------------------------------------------------------------
# 'local' uses output/ directory on local disk (default for dev/CI, zero setup)
# 'supabase' connects to Supabase PostgreSQL using Service Role Key
DATABASE_PROVIDER=local
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. Object Storage: Local Disk vs Cloudflare R2 (Phase 5)
# ------------------------------------------------------------------------------
# 'local' stores artifacts under output/storage/ (default for dev/CI)
# 'r2' uses Cloudflare R2 / S3-compatible object storage with presigned URLs
STORAGE_PROVIDER=local
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=ai-floor-planner-artifacts
# Optional custom public CDN base URL (e.g. https://cdn.myafpapp.com)
R2_PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# 4. Async Worker Queues: BullMQ & Redis (Phase 5)
# ------------------------------------------------------------------------------
# Leave unset or empty for in-process async queue (zero Redis required for dev/CI)
# Provide Redis URL (e.g. Upstash Redis or Redis Cloud) for production split
REDIS_URL=
# REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379

# Active process role: 'api' | 'linux-worker' | 'windows-worker' | 'all' (default: 'all')
WORKER_ROLE=all

# ------------------------------------------------------------------------------
# 5. Windows Native CAD Binaries (Only required on Windows Worker host)
# ------------------------------------------------------------------------------
ACCORECONSOLE_PATH="C:\Program Files\Autodesk\AutoCAD 2021\accoreconsole.exe"
BLENDER_PATH="C:\Program Files\Blender Foundation\Blender 5.2\blender.exe"

# ------------------------------------------------------------------------------
# 6. Security, Rate Limiting & Safety Controls (Phase 6)
# ------------------------------------------------------------------------------
# Maximum AI edit requests allowed per minute per IP (default: 60)
RATE_LIMIT_AI_EDIT_PER_MIN=60
# Disable rate limiting for automated testing (default: false)
RATE_LIMIT_DISABLED=false
