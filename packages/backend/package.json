{
  "name": "@ai-floor-planner/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Server-side AI boundary: Gemini architectural generation, vision/evaluation proxies, and deterministic CAD/PDF/3D/ETABS export services. All provider credentials live here, never in the frontend.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "afp-backend": "./dist-server/server.cjs"
  },
  "scripts": {
    "build": "node ../../scripts/bundle-backend.mjs",
    "bundle": "node ../../scripts/bundle-backend.mjs",
    "prepublishOnly": "pnpm bundle",
    "dev": "node ../../scripts/bundle-backend.mjs --run",
    "start": "node ../../scripts/bundle-backend.mjs --run",
    "worker:windows": "node ../../scripts/bundle-backend.mjs --worker-windows",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --no-error-on-unmatched-pattern",
    "clean": "rm -rf dist dist-server *.tsbuildinfo"
  },
  "dependencies": {
    "@ai-floor-planner/ai-orchestration": "workspace:*",
    "@ai-floor-planner/core": "workspace:*",
    "@ai-floor-planner/geometry-engine": "workspace:*",
    "@ai-floor-planner/interop": "workspace:*",
    "@ai-floor-planner/planning-engine": "workspace:*",
    "@ai-floor-planner/projection-3d": "workspace:^",
    "@ai-floor-planner/renderer": "workspace:^",
    "@node-projects/acad-ts": "^3.2.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@supabase/supabase-js": "^2.49.1",
    "bullmq": "^5.41.0",
    "fast-xml-parser": "5.3.6",
    "ioredis": "^5.5.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
